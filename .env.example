# RFP Studio — copy to .env.local and fill in. Placeholders only: this file is
# committed. Every variable is read through src/lib/env.ts; secrets keep only
# their first line, so never paste a comment after a value.

# ---- Database (Neon via the Vercel Marketplace) ----
# Pooled connection for the app.
DATABASE_URL=
# Direct (unpooled) connection for migrations: pnpm db:migrate.
DATABASE_URL_UNPOOLED=

# ---- Files (Neon Object Storage: a private bucket on the database's branch) ----
# Neon console → the project's branch → Object Storage → bucket + credential
# (scopes storage:read and storage:write). Path-style S3; the endpoint is
# https://<branch-id>.storage.<cell>.<region>.aws.neon.tech
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
STORAGE_BUCKET=
# Only for files written before September 2026, which still live in the retired
# Vercel Blob store: the read path and `pnpm storage:migrate` use it. Otherwise leave empty.
BLOB_READ_WRITE_TOKEN=

# ---- Auth (Better Auth + Microsoft Entra SSO) ----
# `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# The site origin, no trailing slash. Locally: http://localhost:3001
BETTER_AUTH_URL=http://localhost:3001
# Entra app registration. Redirect URI: {BETTER_AUTH_URL}/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
# Tenant GUID (locks sign-in to one directory) or common/organizations/consumers.
MICROSOFT_TENANT_ID=
# Comma-separated. Excludes tenant guests, who keep their own address.
ALLOWED_EMAIL_DOMAINS=kognozconsulting.com
# The workspace new members join; matches the seeded organisation slug.
DEFAULT_WORKSPACE_SLUG=kognoz

# ---- Models ----
# Extraction, drafting, summaries, CHRO questions.
ANTHROPIC_API_KEY=
# Embeddings (voyage-4, 1024-d).
VOYAGE_API_KEY=

# ---- Background jobs (Inngest) ----
# 1 locally: events go to the local dev server (pnpm inngest:dev). Unset in production.
INNGEST_DEV=1
# Production only, from the Inngest dashboard. Without both, /api/inngest refuses to serve.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
